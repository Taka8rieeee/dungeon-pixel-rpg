# 运行时数据（局外存档由 src/save.js 自动创建目录）
data/

# 便携分发包（含 80MB 的 node.exe，不进版本库）
release/

# 依赖（本项目零依赖，兜底）
node_modules/

# 本地工具与代理工作目录
.workbuddy/

# 系统与编辑器杂项
.DS_Store
Thumbs.db
*.log

# Android 构建产物（源码工程在 android/，产物不入库）
www/
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/capacitor-cordova-android-plugins/
android/app/src/main/assets/public/
